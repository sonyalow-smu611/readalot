# Server
PORT=3000

# Supabase (one shared project for the whole team; ask for the keys)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Exposed to the browser by Vite
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google
GOOGLE_BOOKS_API_KEY=
GOOGLE_MAPS_API_KEY=          # no longer needed for the map itself (Leaflet + OpenStreetMap)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_VISION_KEY=      # Scan Book text detection

# Demo identity: profile id of the seeded demo user (printed by `npm run seed -w server`).
# Used by the auth guard when no token is sent. OAuth replaces this later.
DEMO_USER_ID=

# api-ninjas v2 quotes (server-side only, sent as X-Api-Key)
API_NINJAS_KEY=
