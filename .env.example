# Copy to .env at the repo root (the only env file; the client reads it through Vite).
# Every key is optional: the app runs with all of them empty, using the fallbacks noted below.

# Server
PORT=3000

# Supabase (one shared project for the whole team; ask for the keys).
# Required for signing in: the app has no keyless sign-in. On a new project run
# database/schema.sql, then database/profiles_and_tour.sql, in the SQL editor.
# The e2e tests need all three server keys too (they create and delete test readers).
# Server keys empty: the shelf is a demo shelf held in memory, reset on restart: 20 random
# books from Google Books, or 16 built-in books when GOOGLE_BOOKS_API_KEY is empty too.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Exposed to the browser by Vite
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google
# Books: search, metadata, covers and the demo shelf. Empty: the keyless quota runs out quickly;
# search then returns a placeholder book, book pages answer with an error, the demo shelf is the
# built-in one and mood recommendations show without covers.
GOOGLE_BOOKS_API_KEY=
GOOGLE_MAPS_API_KEY=          # nearby stores (lookup not built yet); the people map uses Leaflet + OpenStreetMap
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_VISION_KEY=      # Scan Book text detection

# Demo identity: profile id of the seeded demo user (printed by `npm run seed -w server`).
# Used by the auth guard when no token is sent. OAuth replaces this later.
# Only needed with Supabase; without it the server uses a built-in demo user.
DEMO_USER_ID=

# api-ninjas v2 quotes (server-side only, sent as X-Api-Key). https://api-ninjas.com/api/quotes
# Used for a mood recommendation when Wikiquote has nothing for the book, and for Quote of the
# Day when server/data/quotes.json has not been built.
# Empty: the quote stored with each book in server/data/works.json is shown for a mood, and
# Quote of the Day shows one built-in quote.
API_NINJAS_KEY=

# Wikimedia Enterprise (server-side only). https://enterprise.wikimedia.com/docs/
# Used for the quote shown with a mood recommendation, read from the book's Wikiquote page.
# There is no single API key: sign up for a free account at https://dashboard.enterprise.wikimedia.com/
# and put its username and password here. The server logs in with them to get a 24-hour access
# token. The free plan allows 50,000 article lookups a month.
# Empty: api-ninjas is tried next, then the quote stored with each book in server/data/works.json.
WIKIMEDIA_ENTERPRISE_USERNAME=
WIKIMEDIA_ENTERPRISE_PASSWORD=

# Quote of the Day needs no key when server/data/quotes.json exists. That file is not in the
# repo and is built once per machine with `npm run import-quotes -w server` (see README).

# No key needed: weather (Open-Meteo), the room clock (utctime.app / time.now) and pet photos
# (Wikipedia, Dog CEO) are public APIs called from the server.

# Optional, dev only: where the Vite dev server proxies /api (default http://localhost:3000).
# The Playwright config sets this itself.
# VITE_API_TARGET=http://localhost:3000
